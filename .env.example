# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — used solely for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (https://openrouter.ai/keys) — server only
OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model id that supports JSON output, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH=false
